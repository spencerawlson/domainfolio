# --- Portfolio identity --------------------------------------------------------
PORTFOLIO_NAME=Domainfolio
# The host that renders the catalog (all domains) instead of a single lander.
PORTFOLIO_HOST=localhost
# Canonical URL of the portfolio site (used by the "not listed" page).
PORTFOLIO_URL=
# ISO currency code used to format prices. Default USD.
DEFAULT_CURRENCY=USD

# --- Data --------------------------------------------------------------------
# Directory holding domainfolio.sqlite. Keep it on a Docker volume in prod.
DATA_DIR=./data

# --- Admin -------------------------------------------------------------------
# Password for /admin (login form). Set a long random value in production.
ADMIN_PASSWORD=
# Secret used to sign admin session cookies. Long random value, never shared.
SESSION_SECRET=

# --- Offer notifications -----------------------------------------------------
# Leave all empty to disable email notifications (offers are still stored).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where new-offer notifications are sent.
OFFERS_NOTIFY_EMAIL=

# --- Anti-spam (reserved for v1+) ---------------------------------------------
# Secret for the form CAPTCHA. The offer form has a marked slot where the
# widget integrates; leave empty for now.
TURNSTILE_SECRET=

# --- Lander copy ---------------------------------------------------------------
# "the seller typically responds within <SELLER_RESPONSE_TIME>"
SELLER_RESPONSE_TIME=two business days
